{
  "schema_version": 1,
  "report": {
    "brand": "衡见AI",
    "timezone": "Asia/Shanghai",
    "lookback_hours": 72,
    "tracking_days": 30,
    "max_news": 10,
    "max_interview": 3,
    "max_items_per_source": 2,
    "max_items_per_topic": 4
  },
  "ranking": {
    "minimum_score": 3.0,
    "weights": {
      "freshness": 0.30,
      "importance": 0.30,
      "trust": 0.25,
      "relevance": 0.15
    }
  },
  "dedupe": {
    "title_similarity_threshold": 0.84,
    "max_publication_gap_days": 3,
    "drop_query_parameters": [
      "utm_source",
      "utm_medium",
      "utm_campaign",
      "utm_term",
      "utm_content",
      "gclid",
      "fbclid",
      "ref",
      "source"
    ]
  },
  "collection": {
    "timeout_seconds": 20,
    "max_feed_bytes": 5242880,
    "user_agent": "HengjianAI-Daily/1.0 (+source-verification)",
    "max_items_per_feed": 30
  },
  "sources": [
